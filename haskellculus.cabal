cabal-version:       >=1.10
-- Initial package description 'haskellculus.cabal' generated by 'cabal
-- init'.  For further documentation, see
-- http://haskell.org/cabal/users-guide/

name:                haskellculus
version:             0.1.0.0
synopsis:            Symbolic differentiation for math expressions
description:         Provides an MExp type to store mathematical expressions, in additon to differentiate :: MExp -> String -> MExp and simplify :: MExp -> MExp functions. You can differentiate with respect to any variable.
bug-reports:         https://github.com/MythicalFlame/Haskellculus/issues
license:             LGPL-3.0-or-later
license-files:       COPYING
                     COPYING.LESSER
author:              MythicalFlame
maintainer:          82922845+MythicalFlame@users.noreply.github.com
category:            Math
build-type:          Simple
extra-source-files:  CHANGELOG.md

executable haskellculus
  main-is:             Main.hs
  other-modules:       Haskellculus.MExp
                       Haskellculus.Differentiate
                       Haskellculus.Simplify
  build-depends:       base >=4.20 && <5
  default-language:    Haskell2010
  ghc-options:         -O1
